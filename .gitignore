docs/superpowers/*
# Working directory for the Hermes Agent's session state (~/.hermes/ at runtime;
# also created in-repo when an agent operates in this checkout). Plans, audit
# logs, and per-session caches are never artifacts of the codebase.
.hermes/

# Desktop/bootstrap install marker written into the managed checkout root by the
# bootstrap installer. It is Hermes-managed runtime state, never a code change —
# ignore it so `hermes update`'s `git stash push --include-untracked` does not
# treat it as a local edit and autostash it on every run (#38529).
.hermes-bootstrap-complete

# Persistent dev sandbox dir (scripts/dev-sandbox.sh --persistent)
.hermes-sandbox/

# Interrupted-update breadcrumb + recovery lock written next to the shared venv
# by `hermes update` / launch-time self-heal. Runtime state, never a code change
# — ignore so `git status` stays clean and update's autostash skips them.
.update-incomplete
.update-incomplete.lock

# Tool Search live-test harness output — non-deterministic model transcripts,
# regenerated by scripts/tool_search_livetest.py. Never an artifact of the repo.
scripts/out/

# Per-release changelog drafts. These exist only transiently during a release
# cut (passed to `gh release create --notes-file`); the GitHub Release itself
# stores the published notes. They are not a build artifact and must never be
# committed to the repo root. See the hermes-release skill.
RELEASE_v*.md

# Desktop demo-run scratch output (hermes writes demo/*.txt during recorded
# walkthroughs). Throwaway artifacts, never part of the app.
apps/desktop/demo/

# PR infographics are rendered locally and embedded in PR descriptions via the
# image-provider (fal.media) URL — they are NEVER committed to the repo. The
# PR body is the archive. See the hermes-agent-dev skill's
# pr-infographic-workflow reference (storage rule + lapse #8 / #COMMIT-1).
infographic/
user-config/.env

# === Junction Runtime Directories ===
# user-skills/, user-plugins/, user-config/{hooks,scripts,memories}/ are junctions
# to ~/.hermes/{skills,plugins,hooks,scripts,memories}/
# Strategy: ignore files at root, allow subdirs, then ignore specific unwanted patterns

# --- user-skills/ ---
user-skills/*
!user-skills/*/

# Ignore privacy/runtime files at ANY depth
user-skills/**/DESCRIPTION.md
user-skills/**/MEMORY.md
user-skills/**/snapshots/
user-skills/**/_example_snapshots/
user-skills/**/__pycache__/
user-skills/**/*.pyc
user-skills/**/*.lock
user-skills/**/.usage.json
user-skills/**/.bundled_manifest
user-skills/**/.curator_state
user-skills/**/.curator_backups/
user-skills/**/.hub/

# --- user-plugins/ ---
user-plugins/*
!user-plugins/*/

user-plugins/**/DESCRIPTION.md
user-plugins/**/MEMORY.md
user-plugins/**/__pycache__/
user-plugins/**/*.pyc
user-plugins/**/*.lock
user-plugins/**/.usage.json

# --- user-config/hooks/ ---
user-config/hooks/*
!user-config/hooks/*/

user-config/hooks/**/__pycache__/
user-config/hooks/**/*.pyc

# --- user-config/scripts/ ---
# Ignore all files in scripts/
user-config/scripts/*
# Un-ignore subdirectories first (so git can look inside)
!user-config/scripts/*/
# Then un-ignore specific file types
!user-config/scripts/*.py
!user-config/scripts/*.sh
!user-config/scripts/*.bat

# --- user-config/memories/ ---
user-config/memories/*
!user-config/memories/USER.md

user-config/memories/MEMORY.md
user-config/memories/*.lock

# --- Profile directories ---
# Profile skills follow same rules as user-skills/
user-config/profiles/*/skills/**
!user-config/profiles/*/skills/*/
!user-config/profiles/*/skills/*/*/
!user-config/profiles/*/skills/*/*/*/
!user-config/profiles/*/skills/*/*/*/*/

# Ignore privacy/runtime files in profile skills at ANY depth
user-config/profiles/*/skills/**/DESCRIPTION.md
user-config/profiles/*/skills/**/MEMORY.md
user-config/profiles/*/skills/**/snapshots/
user-config/profiles/*/skills/**/_example_snapshots/
user-config/profiles/*/skills/**/__pycache__/
user-config/profiles/*/skills/**/*.pyc
user-config/profiles/*/skills/**/*.lock
user-config/profiles/*/skills/**/.usage.json
user-config/profiles/*/skills/**/.bundled_manifest
user-config/profiles/*/skills/**/.curator_state
user-config/profiles/*/skills/**/.curator_backups/
user-config/profiles/*/skills/**/.hub/

# Profile memories contain sensitive data (tokens, account IDs)
user-config/profiles/*/memories/*

# Profile runtime config (contains provider settings, preferences)
user-config/profiles/*/config.yaml

# --- User config runtime files ---
user-config/config.yaml
user-config/cron/jobs.json

# --- Global runtime artifacts ---
*.pyc
__pycache__/
*.lock
.usage.json
.bundled_manifest
.curator_state
.curator_backups/
.hub/
